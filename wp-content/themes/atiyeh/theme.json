{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "آبی اصلی", "color": "#1757b8" },
        { "slug": "primary-dark", "name": "آبی تیره", "color": "#0f3f8a" },
        { "slug": "ink", "name": "آبی خیلی تیره", "color": "#0a2250" },
        { "slug": "accent", "name": "آبی تاکیدی روشن", "color": "#7ab8ff" },
        { "slug": "soft", "name": "آبی ملایم", "color": "#e1ecfb" },
        { "slug": "soft-2", "name": "آبی ملایم ۲", "color": "#d3e1f5" },
        { "slug": "soft-3", "name": "آبی ملایم ۳", "color": "#dbe8fb" },
        { "slug": "slate", "name": "طوسی تیره", "color": "#2f3b43" },
        { "slug": "slate-900", "name": "طوسی خیلی تیره", "color": "#1f262b" },
        { "slug": "slate-800", "name": "طوسی کارت", "color": "#2a3238" },
        { "slug": "page", "name": "پس‌زمینه صفحه", "color": "#f4f6f5" },
        { "slug": "section", "name": "پس‌زمینه خدمات", "color": "#e6edf6" },
        { "slug": "border", "name": "حاشیه", "color": "#dfe5e2" },
        { "slug": "white", "name": "سفید", "color": "#ffffff" }
      ]
    },
    "layout": { "contentSize": "820px", "wideSize": "1240px" },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "vazirmatn",
          "name": "Vazirmatn",
          "fontFamily": "Vazirmatn, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Vazirmatn",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Vazirmatn-Variable.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "کوچک", "size": "14px" },
        { "slug": "medium", "name": "متوسط", "size": "17px" },
        { "slug": "large", "name": "بزرگ", "size": "23px" },
        { "slug": "x-large", "name": "خیلی بزرگ", "size": "38px" }
      ]
    },
    "spacing": { "units": [ "px", "%", "rem", "vw" ] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--page)", "text": "var(--wp--preset--color--slate-900)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--vazirmatn)", "lineHeight": "1.8", "fontSize": "var(--wp--preset--font-size--medium)" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "heading": { "typography": { "fontWeight": "900", "lineHeight": "1.45" } }
    }
  }
}
